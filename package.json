{
  "name": "laser-tag-cartone",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "npm run types && tsc --noEmit && tsc -p worker && vite build",
    "deploy": "npm run build && wrangler deploy",
    "types": "wrangler types worker/worker-configuration.d.ts > /dev/null",
    "preview": "vite preview --host",
    "check": "node --experimental-strip-types src/check.ts"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "@fontsource-variable/baloo-2": "^5.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "wrangler": "^4.151.2"
  },
  "dependencies": {
    "js-aruco2": "^2.0.0",
    "qrcode-generator": "^2.0.4",
    "three": "^0.186.1"
  }
}
